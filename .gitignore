# Media test files (large binaries)
# Ignore heavyweight media (ProRes/H264/etc. videos committed into workspaces
# locally). Procedural, deterministic test fixtures ARE committed so CI can
# reproduce integration tests.
test_media/*
!test_media/scripts/
!test_media/gradient_seq/
!test_media/blend_bg/
!test_media/blend_fg/
!test_media/hap_gradient/
!test_media/hap_gradient_basic/
!test_media/hap_gradient_q/
!test_media/hap_hdr/
!test_media/aces_test_pattern/
*.mov
*.mp4
*.avi
*.prores
*.hap
# HAP test fixtures ARE committed (procedurally generated by tests/tools/generate_hap_fixture).
!test_media/hap_gradient/test.mov
!test_media/hap_gradient_basic/test.mov
!test_media/hap_gradient_q/test.mov
!test_media/hap_hdr/test.mov

# Screenshots output
screenshots/
debug/

# Integration test outputs (goldens live at tests/goldens/ and ARE committed)
test_output/

# ImGui settings
imgui.ini

# Script results
script_result.json

# Local perf diagnostics (--script output from scripts/perf_diag_*.json runs)
scripts/perf_diag_*.json

# Project files
*.autosave
*.backup
*.bak
*.tmp
*.autosave.entity
/project.entity

# Entity project caches — machine-local, regenerable. ADR-0009: any
# project folder accidentally committed alongside the source tree
# (e.g. a small demo project) shouldn't drag the cache. See
# docs/reference/PROJECT_LAYOUT.md for the project layout reference.
.cache/

# Claude Code runtime state — kept local only, not for source control.
# CLAUDE.md (root + sub-dirs) covers architectural docs auto-loaded by
# Claude Code; local copies live alongside the codebase but aren't tracked.
.claude/
.claude-agents/
.claude-sessions/
CLAUDE.md

# CTest runtime artifacts
/Testing/

# IDE
*.idea/
*.clion/

# Tracy perf workflow
# Captures and intermediate CSVs are large machine-local files; ignore them.
# Timestamped summaries are also ignored. Only .baseline.summary.json files
# (no timestamp segment) are intended for commit as canonical baselines.
docs/perf/*.tracy
docs/perf/*.csv
docs/perf/*-*.summary.json
# Synthetic fixtures generated by setup-fixtures.ps1 (~9 GB); regenerable.
test_media/perf/
build-d3d12tests/
test-reports/
