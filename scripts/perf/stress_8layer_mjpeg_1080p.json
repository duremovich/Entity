{
    "version": 1,
    "description": "8-layer MJPEG cache-pressure stress. 3 AddTrack commands extend the default 5 tracks to 8. Stress focus: decode thread saturation, FrameCache LRU pressure under 8 simultaneous MJPEG streams. Requires: test_media/perf/checker_1080p_mjpeg.mov (generate via scripts/perf/setup-fixtures.ps1).",
    "target_fps": 60,

    "commands": [
        { "type": "AddScreen", "name": "Output A", "width": 1920, "height": 1080 },

        { "type": "AddTrack" },
        { "type": "AddTrack" },
        { "type": "AddTrack" },

        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 0, "position": 0 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 1, "position": 15 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 2, "position": 30 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 3, "position": 45 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 4, "position": 60 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 5, "position": 75 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 6, "position": 90 },
        { "type": "ImportVideo", "filepath": "test_media/perf/checker_1080p_mjpeg.mov", "trackIndex": 7, "position": 105 },

        { "type": "SetClipTargetScreen", "trackIndex": 0, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 1, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 2, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 3, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 4, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 5, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 6, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 7, "clipIndex": 0, "screenName": "Output A" },

        { "type": "WaitFrames", "count": 60 },

        { "type": "SeekToFrame", "frame": 0 },
        { "type": "Play" },

        { "type": "WaitSeconds", "count": 30 },

        { "type": "Pause" }
    ]
}
