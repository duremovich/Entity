{
    "version": 1,
    "description": "Stress scenario: 2 layers of ProRes 4444 4K Mandelbrot, 2 output screens at 4K, 30s playback. Stress focus: GPU upload bandwidth, descriptor heap throughput, decode buffer size. Requires: test_media/perf/mandelbrot_4k_prores.mov (generate via scripts/perf/setup-fixtures.ps1).",
    "target_fps": 60,

    "commands": [
        { "type": "AddScreen", "name": "Output A", "width": 3840, "height": 2160 },
        { "type": "AddScreen", "name": "Output B", "width": 3840, "height": 2160 },

        { "type": "ImportVideo", "filepath": "test_media/perf/mandelbrot_4k_prores.mov", "trackIndex": 0, "position": 0 },
        { "type": "ImportVideo", "filepath": "test_media/perf/mandelbrot_4k_prores.mov", "trackIndex": 1, "position": 30 },

        { "type": "SetClipTargetScreen", "trackIndex": 0, "clipIndex": 0, "screenName": "Output A" },
        { "type": "SetClipTargetScreen", "trackIndex": 1, "clipIndex": 0, "screenName": "Output B" },

        { "type": "WaitFrames", "count": 60 },

        { "type": "SeekToFrame", "frame": 0 },
        { "type": "Play" },

        { "type": "WaitSeconds", "count": 30 },

        { "type": "Pause" }
    ]
}
