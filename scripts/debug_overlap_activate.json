{
    "version": 1,
    "description": "Test: Overlapping clips on different tracks - clip B activates while A is playing",
    "commands": [
        {"type": "ImportVideo", "filepath": "test_media/RED_TEST.mov", "trackIndex": 0, "position": 0},
        {"type": "ImportVideo", "filepath": "test_media/BLUE_TEST.mov", "trackIndex": 1, "position": 6666666},
        {"type": "WaitFrames", "count": 90},
        {"type": "LogClipState"},
        {"type": "SelectTab", "tabName": "Stage"},

        {"type": "SeekToFrame", "frame": 0},
        {"type": "WaitFrames", "count": 30},
        {"type": "CaptureScreenshot", "filepath": "debug/overlap_initial.png"},

        {"type": "Play"},
        {"type": "WaitFrames", "count": 300},
        {"type": "Pause"},
        {"type": "CaptureScreenshot", "filepath": "debug/overlap_after_cross.png"},

        {"type": "SeekToFrame", "frame": 100},
        {"type": "WaitFrames", "count": 60},
        {"type": "CaptureScreenshot", "filepath": "debug/overlap_seek_back.png"},

        {"type": "Play"},
        {"type": "WaitFrames", "count": 300},
        {"type": "Pause"},
        {"type": "CaptureScreenshot", "filepath": "debug/overlap_cross_again.png"},

        {"type": "SeekToFrame", "frame": 50},
        {"type": "WaitFrames", "count": 60},

        {"type": "Play"},
        {"type": "WaitFrames", "count": 300},
        {"type": "Pause"},
        {"type": "CaptureScreenshot", "filepath": "debug/overlap_cross_third.png"},

        {"type": "LogClipState"},
        {"type": "Exit"}
    ]
}
