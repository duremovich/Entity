{
    "version": 1,
    "description": "Ping-pong integration test. Loads 16-frame PNG sequence, sets PingPong mode and extends duration to 64 timeline frames. Verifies DecodeSystem ping-pong branch: tl 8 is in the forward phase (source 8), tl 24 is in the reverse phase (source 15 - (24 % 16) = 7).",
    "commands": [
        {"type": "AddScreen", "name": "PingPongScreen", "width": 64, "height": 64},
        {"type": "ImportVideo", "filepath": "test_media/gradient_seq/frame_000.png", "trackIndex": 0, "position": 0},
        {"type": "WaitFrames", "count": 10},
        {"type": "SetClipPlaybackMode", "trackIndex": 0, "clipIndex": 0, "mode": "PingPong"},
        {"type": "SetClipDuration", "trackIndex": 0, "clipIndex": 0, "duration": 64},
        {"type": "WaitFrames", "count": 20},
        {"type": "SeekToFrame", "frame": 8},
        {"type": "WaitFrames", "count": 30},
        {"type": "CaptureHash", "hashFilepath": "test_output/ping_pong/frame_forward_8.hash", "goldenFilepath": "tests/goldens/ping_pong/frame_forward_8.hash", "composeSlot": 0},
        {"type": "SeekToFrame", "frame": 24},
        {"type": "WaitFrames", "count": 45},
        {"type": "CaptureHash", "hashFilepath": "test_output/ping_pong/frame_reverse_24.hash", "goldenFilepath": "tests/goldens/ping_pong/frame_reverse_24.hash", "composeSlot": 0},
        {"type": "Exit"}
    ]
}
