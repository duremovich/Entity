{
    "version": 1,
    "description": "Imports the 16-frame gradient PNG sequence, seeks to frames 0 and 8, and asserts pixel hashes match recorded goldens. Exercises PNG decode path, Timeline seek correctness, and compositor end-to-end.",
    "commands": [
        {
            "type": "AddScreen",
            "name": "PngSeqScreen",
            "width": 64,
            "height": 64
        },
        {
            "type": "ImportVideo",
            "filepath": "test_media/gradient_seq/frame_000.png",
            "trackIndex": 0,
            "position": 0
        },
        {
            "type": "WaitFrames",
            "count": 30
        },
        {
            "type": "SeekToFrame",
            "frame": 0
        },
        {
            "type": "WaitFrames",
            "count": 30
        },
        {
            "type": "CaptureHash",
            "hashFilepath": "test_output/png_sequence_seek/frame_0.hash",
            "goldenFilepath": "tests/goldens/png_sequence_seek/frame_0.hash",
            "composeSlot": 0
        },
        {
            "type": "SeekToFrame",
            "frame": 8
        },
        {
            "type": "WaitFrames",
            "count": 30
        },
        {
            "type": "CaptureHash",
            "hashFilepath": "test_output/png_sequence_seek/frame_8.hash",
            "goldenFilepath": "tests/goldens/png_sequence_seek/frame_8.hash",
            "composeSlot": 0
        },
        {
            "type": "Exit"
        }
    ]
}
