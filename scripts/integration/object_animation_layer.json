{
    "version": 1,
    "description": "Phase 3.3/3.4 gate: CreateObjectAnimationLayer places an OA layer on track 0 targeting OATestScreen. AddKeyframe writes PositionX=5.0 at frame 0. After playback, AssertObjectAnimationOutput checks the editor-side component and AssertScreenSnapshot confirms the fold-in reached the SceneSnapshot. A second block seeks past the OA layer's duration and asserts the snapshot reverts to the un-overridden position (0.0 = stale-output regression).",
    "commands": [
        {
            "type": "AddScreen",
            "name": "OATestScreen",
            "width": 64,
            "height": 64
        },
        {
            "type": "CreateObjectAnimationLayer",
            "trackIndex": 0,
            "startFrame": 0,
            "duration": 300
        },
        {
            "type": "AddKeyframe",
            "trackIndex": 0,
            "clipIndex": 0,
            "property": "PositionX",
            "frame": 0,
            "value": 5.0
        },
        {
            "type": "Play"
        },
        {
            "type": "WaitSeconds",
            "count": 0.2
        },
        {
            "type": "Pause"
        },
        {
            "type": "AssertObjectAnimationOutput",
            "trackIndex": 0,
            "layerIndex": 0,
            "field": "positionX",
            "expected": 5.0,
            "tolerance": 0.01
        },
        {
            "type": "AssertObjectAnimationOutput",
            "trackIndex": 0,
            "layerIndex": 0,
            "field": "hasPosition",
            "expected": 1.0,
            "tolerance": 0.01
        },
        {
            "type": "AssertScreenSnapshot",
            "screenName": "OATestScreen",
            "field": "positionX",
            "expected": 5.0,
            "tolerance": 0.01
        },
        {
            "type": "SeekToFrame",
            "frame": 400
        },
        {
            "type": "WaitSeconds",
            "count": 0.2
        },
        {
            "type": "AssertScreenSnapshot",
            "screenName": "OATestScreen",
            "field": "positionX",
            "expected": 0.0,
            "tolerance": 0.01
        },
        {
            "type": "Exit"
        }
    ]
}
