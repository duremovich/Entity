{
    "version": 1,
    "description": "F2: Audio tone playback capture. Loads the 1 kHz sine test fixture, plays for 2 seconds, then asserts the LoopbackDevice capture has non-zero RMS and that Goertzel energy at 1000 Hz is at least 3x the energy at 500 Hz and 1500 Hz. Requires tests/fixtures/audio/tone_1khz.mov (generated by scripts/perf/setup-audio-fixtures.ps1). Uses WaitSeconds not WaitFrames because headless runs at thousands of fps and audio capture needs real wall-clock time to accumulate frames.",
    "commands": [
        {
            "type": "AddScreen",
            "name": "AudioTestScreen",
            "width": 320,
            "height": 240
        },
        {
            "type": "ImportVideo",
            "filepath": "tests/fixtures/audio/tone_1khz.mov",
            "trackIndex": 0,
            "position": 0
        },
        {
            "type": "WaitFrames",
            "count": 10
        },
        {
            "type": "Play"
        },
        {
            "type": "WaitSeconds",
            "count": 2.0
        },
        {
            "type": "Pause"
        },
        {
            "type": "WaitFrames",
            "count": 5
        },
        {
            "type": "AssertAudioCaptureRms",
            "minRms": 0.005
        },
        {
            "type": "AssertAudioCaptureGoertzel",
            "targetHz": 1000.0,
            "referenceHz": 500.0,
            "minRatio": 3.0
        },
        {
            "type": "AssertAudioCaptureGoertzel",
            "targetHz": 1000.0,
            "referenceHz": 1500.0,
            "minRatio": 3.0
        },
        {
            "type": "Exit"
        }
    ]
}
