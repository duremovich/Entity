{
    "version": 1,
    "description": "Phase A — Cue tags. Adds three cues at known timestamps, asserts cue lookup, fires one, then verifies the timeline didn't lose any cues. No media (no ImportVideo) — pure timeline-state integration test.",
    "commands": [
        {"type": "AddCueAt",   "number": 1.0, "timestamp": 1000000, "label": "Intro"},
        {"type": "AddCueAt",   "number": 1.5, "timestamp": 2000000, "label": "Verse"},
        {"type": "AddCueAt",   "number": 2.0, "timestamp": 4000000, "label": "Drop"},
        {"type": "WaitFrames", "count": 2},

        {"type": "AssertCueCount",  "count": 3},
        {"type": "AssertCueExists", "number": 1.0},
        {"type": "AssertCueExists", "number": 1.5},
        {"type": "AssertCueExists", "number": 2.0},

        {"type": "FireCue",    "number": 2.0},
        {"type": "WaitFrames", "count": 4},
        {"type": "Pause"},

        {"type": "FireCue",    "number": 1.0},
        {"type": "WaitFrames", "count": 4},
        {"type": "Pause"},

        {"type": "AssertCueCount", "count": 3},
        {"type": "Exit"}
    ]
}
