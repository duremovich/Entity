{
    "version": 1,
    "description": "Test keyframe shapes for different interpolation types: Diamond (Linear), Square (Hold), Hourglass (EaseInOut), Half shapes (EaseIn/EaseOut)",
    "commands": [
        {"type": "ImportVideo", "filepath": "test_media/RED_TEST.mov", "trackIndex": 0, "position": 0},
        {"type": "WaitFrames", "count": 30},

        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionX", "frame": 0, "value": -0.5, "interpolation": "Linear"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionX", "frame": 30, "value": 0.0, "interpolation": "EaseInOut"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionX", "frame": 60, "value": 0.5, "interpolation": "Step"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionX", "frame": 90, "value": 0.0, "interpolation": "EaseIn"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionX", "frame": 120, "value": -0.5, "interpolation": "EaseOut"},

        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionY", "frame": 0, "value": 0.0, "interpolation": "Linear"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionY", "frame": 60, "value": 0.3, "interpolation": "EaseInOut"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "PositionY", "frame": 120, "value": 0.0, "interpolation": "Linear"},

        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Rotation", "frame": 0, "value": 0.0, "interpolation": "Linear"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Rotation", "frame": 60, "value": 45.0, "interpolation": "Step"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Rotation", "frame": 120, "value": 0.0, "interpolation": "EaseInOut"},

        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Opacity", "frame": 0, "value": 1.0, "interpolation": "Linear"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Opacity", "frame": 30, "value": 0.5, "interpolation": "EaseIn"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Opacity", "frame": 60, "value": 0.0, "interpolation": "EaseOut"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Opacity", "frame": 90, "value": 0.5, "interpolation": "Step"},
        {"type": "AddKeyframe", "trackIndex": 0, "clipIndex": 0, "property": "Opacity", "frame": 120, "value": 1.0, "interpolation": "Linear"},

        {"type": "SelectClip", "trackIndex": 0, "clipIndex": 0, "expand": true},
        {"type": "WaitFrames", "count": 30},

        {"type": "SeekToFrame", "frame": 0},
        {"type": "WaitFrames", "count": 10},
        {"type": "CaptureScreenshot", "filepath": "debug/keyframe_shapes_frame0.png", "region": "fullWindow"},

        {"type": "SeekToFrame", "frame": 30},
        {"type": "WaitFrames", "count": 10},
        {"type": "CaptureScreenshot", "filepath": "debug/keyframe_shapes_frame30.png", "region": "fullWindow"},

        {"type": "SeekToFrame", "frame": 60},
        {"type": "WaitFrames", "count": 10},
        {"type": "CaptureScreenshot", "filepath": "debug/keyframe_shapes_frame60.png", "region": "fullWindow"},

        {"type": "Play"},
        {"type": "WaitFrames", "count": 90},
        {"type": "Pause"},
        {"type": "CaptureScreenshot", "filepath": "debug/keyframe_shapes_animated.png", "region": "fullWindow"},

        {"type": "Exit"}
    ]
}
