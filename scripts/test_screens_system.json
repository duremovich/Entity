{
    "version": 1,
    "description": "Test the screens and models system - verify default screen and clip target screen assignment",
    "commands": [
        {"type": "ImportVideo", "filepath": "test_media/RED_TEST.mov", "trackIndex": 0, "position": 0},
        {"type": "WaitFrames", "count": 60},

        {"type": "SelectClip", "trackIndex": 0, "clipIndex": 0, "expand": false},
        {"type": "WaitFrames", "count": 10},

        {"type": "CaptureScreenshot", "filepath": "debug/screens_test_properties.png", "region": "fullWindow"},

        {"type": "SeekToFrame", "frame": 30},
        {"type": "WaitFrames", "count": 10},
        {"type": "SelectTab", "tabName": "Stage"},
        {"type": "WaitFrames", "count": 5},
        {"type": "CaptureScreenshot", "filepath": "debug/screens_test_stage.png", "region": "fullWindow"},

        {"type": "Exit"}
    ]
}
